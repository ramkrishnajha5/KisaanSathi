# ================================================================
# KisaanSathi Environment Configuration
# Copy this file to .env and adjust values for your local environment
# ================================================================

# Application
APP_NAME="KisaanSathi"
APP_ENV="development"
DEBUG=True

# Backend Server
API_HOST="127.0.0.1"
API_PORT=8000

# Database (SQLite default for development & MCA demo)
DATABASE_URL="sqlite:///./kisaansathi.db"

# ML Model Settings
MODEL_PATH="ml/models/kisaansathi_mobilenetv2.keras"
MODEL_CONFIDENCE_THRESHOLD=0.60

# External API Keys (Optional - for future phases)
# Open-Meteo does not require a key; if using OpenWeatherMap, provide key below:
OPENWEATHERMAP_API_KEY=""

# Data.gov.in / Mandi Agmarknet API Key (Register free at https://data.gov.in/)
DATA_GOV_IN_API_KEY=""

# Agri News API Key (Optional)
NEWS_API_KEY=""
